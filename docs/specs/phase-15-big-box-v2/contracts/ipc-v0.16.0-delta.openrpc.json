{
  "openrpc": "1.2.6",
  "info": {
    "title": "arcadia agent IPC — delta v0.16.0 (phase 15)",
    "version": "0.16.0-delta",
    "description": "Only the additions of v0.16.0 over v0.15.0 (phase 13 plus the phase 14 methods). The full contract contracts/ipc.openrpc.json v0.16.0 is generated by a task: v0.15.0 + phase 14 + this delta, with info.version 0.16.0 and x-timetobeat added to info [TTB-029]. Nothing that exists changes.",
    "x-timetobeat": {
      "source": "hltb",
      "fallbackSource": "igdb",
      "fallbackMapping": {
        "mainSeconds": "hastily",
        "mainExtraSeconds": "normally",
        "completionistSeconds": "completely"
      },
      "requestIntervalMs": 2000,
      "requestTimeoutMs": 10000,
      "syncTimeoutMs": 25000,
      "foundTtlDays": 90,
      "fallbackFoundTtlDays": 30,
      "doubtTtlDays": 30,
      "notFoundTtlDays": 30,
      "backoffMinutes": [1, 5, 30, 60],
      "batchQueueMax": 1000,
      "maxCandidates": 10,
      "termMaxLength": 200,
      "settingKeys": {
        "enabled": "timeToBeat.enabled",
        "afterMetadata": "timeToBeat.afterMetadata"
      }
    }
  },
  "methods": [
    {
      "name": "timeToBeat.get",
      "summary": "Returns the cached time to beat of a game at once [TTB-007]. With fetch true, an enabled service and a missing, expired or retitled row, queues one interactive lookup and answers pending true [TTB-008]; the end of the lookup comes as timeToBeat.changed. Never fails because of a source: both sources unavailable shows as unavailable true [TTB-011, TTB-013, TTB-038].",
      "paramStructure": "by-name",
      "params": [
        { "name": "gameId", "required": true, "schema": { "type": "integer", "minimum": 1 } },
        { "name": "fetch", "required": false, "schema": { "type": "boolean", "default": false } }
      ],
      "result": { "name": "timeToBeat", "schema": { "$ref": "#/components/schemas/TimeToBeat" } },
      "errors": [
        { "$ref": "#/components/errors/InvalidParams" },
        { "$ref": "#/components/errors/GameNotFound" },
        { "$ref": "#/components/errors/InternalError" }
      ]
    },
    {
      "name": "timeToBeat.refresh",
      "summary": "Looks the game up now (HowLongToBeat first, IGDB fallback per hltb-rules §10.1), ignoring the cache validity and the back-off of both sources but going through the rate limiters and the single in-flight request, within x-timetobeat.syncTimeoutMs; writes, sends timeToBeat.changed and answers like timeToBeat.get. A confirmed found row re-reads the values of its confirmed id, without fallback. Fails with -32011 only when nothing was written [TTB-006, TTB-020, TTB-033, TTB-034].",
      "paramStructure": "by-name",
      "params": [
        { "name": "gameId", "required": true, "schema": { "type": "integer", "minimum": 1 } }
      ],
      "result": { "name": "timeToBeat", "schema": { "$ref": "#/components/schemas/TimeToBeat" } },
      "errors": [
        { "$ref": "#/components/errors/InvalidParams" },
        { "$ref": "#/components/errors/GameNotFound" },
        { "$ref": "#/components/errors/TimeToBeatUnavailable" },
        { "$ref": "#/components/errors/InternalError" }
      ]
    },
    {
      "name": "timeToBeat.search",
      "summary": "Searches HowLongToBeat with term (or the search term of the game title when absent) and returns up to 10 candidates scored against the game title, best first. The row of the game does not change; the candidates are kept in memory for timeToBeat.choose [TTB-021].",
      "paramStructure": "by-name",
      "params": [
        { "name": "gameId", "required": true, "schema": { "type": "integer", "minimum": 1 } },
        { "name": "term", "required": false, "schema": { "type": "string", "minLength": 1, "maxLength": 200 } }
      ],
      "result": { "name": "search", "schema": { "$ref": "#/components/schemas/TimeToBeatSearchResult" } },
      "errors": [
        { "$ref": "#/components/errors/InvalidParams" },
        { "$ref": "#/components/errors/GameNotFound" },
        { "$ref": "#/components/errors/TimeToBeatUnavailable" },
        { "$ref": "#/components/errors/InternalError" }
      ]
    },
    {
      "name": "timeToBeat.choose",
      "summary": "Confirms the match by hand: externalId must be one of the candidates kept for the game (last search or doubt row); the row becomes found and confirmed with that candidate's values, without a request. An empty externalId makes it not-found and confirmed. Sends timeToBeat.changed [TTB-022].",
      "paramStructure": "by-name",
      "params": [
        { "name": "gameId", "required": true, "schema": { "type": "integer", "minimum": 1 } },
        { "name": "externalId", "required": true, "schema": { "type": "string", "maxLength": 32 } }
      ],
      "result": { "name": "timeToBeat", "schema": { "$ref": "#/components/schemas/TimeToBeat" } },
      "errors": [
        { "$ref": "#/components/errors/InvalidParams" },
        { "$ref": "#/components/errors/GameNotFound" },
        { "$ref": "#/components/errors/InternalError" }
      ]
    },
    {
      "name": "timeToBeat.getSettings",
      "summary": "Reads the two switches of the service from app_setting; an absent key is on [TTB-023].",
      "paramStructure": "by-name",
      "params": [],
      "result": { "name": "settings", "schema": { "$ref": "#/components/schemas/TimeToBeatSettings" } },
      "errors": [ { "$ref": "#/components/errors/InternalError" } ]
    },
    {
      "name": "timeToBeat.setSettings",
      "summary": "Writes the switches that are present (at least one) and answers the final state. Turning enabled off empties the queue and stops every request [TTB-023].",
      "paramStructure": "by-name",
      "params": [
        { "name": "enabled", "required": false, "schema": { "type": "boolean" } },
        { "name": "afterMetadata", "required": false, "schema": { "type": "boolean" } }
      ],
      "result": { "name": "settings", "schema": { "$ref": "#/components/schemas/TimeToBeatSettings" } },
      "errors": [
        { "$ref": "#/components/errors/InvalidParams" },
        { "$ref": "#/components/errors/InternalError" }
      ]
    },
    {
      "name": "timeToBeat.changed",
      "summary": "Server-to-client notification (no id, no response) sent to every connection after a lookup or a choice of the game was written [TTB-008, TTB-020, TTB-022]. Carries only the game id (ADR 0031). Never sent for a failure nor after BeginShutdown. A full connection queue drops it (IPC-017).",
      "x-notification": true,
      "paramStructure": "by-name",
      "params": [
        { "name": "gameId", "required": true, "schema": { "type": "integer", "minimum": 1 } }
      ],
      "result": { "name": "none", "schema": { "type": "null" } }
    }
  ],
  "components": {
    "schemas": {
      "TimeToBeatSeconds": {
        "oneOf": [ { "type": "integer", "minimum": 1 }, { "type": "null" } ]
      },
      "TimeToBeat": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gameId", "state", "source", "externalId", "externalTitle", "mainSeconds", "mainExtraSeconds",
          "completionistSeconds", "fetchedAt", "confirmed", "stale", "pending", "unavailable", "candidates"
        ],
        "properties": {
          "gameId": { "type": "integer", "minimum": 1 },
          "state": { "type": "string", "enum": ["none", "found", "doubt", "not-found"] },
          "source": {
            "type": "string",
            "enum": ["hltb", "igdb", ""],
            "description": "Empty with state none; igdb only with state found (IGDB game_time_to_beats used as fallback when HowLongToBeat failed or found nothing) [TTB-033, TTB-034]."
          },
          "externalId": { "type": "string" },
          "externalTitle": { "type": "string" },
          "mainSeconds": { "$ref": "#/components/schemas/TimeToBeatSeconds" },
          "mainExtraSeconds": { "$ref": "#/components/schemas/TimeToBeatSeconds" },
          "completionistSeconds": { "$ref": "#/components/schemas/TimeToBeatSeconds" },
          "fetchedAt": { "oneOf": [ { "type": "string", "format": "date-time" }, { "type": "null" } ] },
          "confirmed": { "type": "boolean" },
          "stale": { "type": "boolean" },
          "pending": { "type": "boolean" },
          "unavailable": { "type": "boolean" },
          "candidates": {
            "type": "array",
            "maxItems": 10,
            "items": { "$ref": "#/components/schemas/TimeToBeatCandidate" }
          }
        }
      },
      "TimeToBeatCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "externalId", "title", "year", "platforms", "mainSeconds", "mainExtraSeconds", "completionistSeconds", "score"
        ],
        "properties": {
          "externalId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "year": { "oneOf": [ { "type": "integer", "minimum": 1950, "maximum": 2100 }, { "type": "null" } ] },
          "platforms": { "type": "array", "items": { "type": "string" } },
          "mainSeconds": { "$ref": "#/components/schemas/TimeToBeatSeconds" },
          "mainExtraSeconds": { "$ref": "#/components/schemas/TimeToBeatSeconds" },
          "completionistSeconds": { "$ref": "#/components/schemas/TimeToBeatSeconds" },
          "score": { "type": "integer", "minimum": 0, "maximum": 1000 }
        }
      },
      "TimeToBeatSearchResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidates"],
        "properties": {
          "candidates": {
            "type": "array",
            "maxItems": 10,
            "items": { "$ref": "#/components/schemas/TimeToBeatCandidate" }
          }
        }
      },
      "TimeToBeatSettings": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled", "afterMetadata"],
        "properties": {
          "enabled": { "type": "boolean" },
          "afterMetadata": { "type": "boolean" }
        }
      }
    },
    "errors": {
      "TimeToBeatUnavailable": {
        "code": -32011,
        "message": "Provider unavailable",
        "data": {
          "type": "object",
          "required": ["provider", "reason"],
          "properties": {
            "provider": { "type": "string", "enum": ["hltb"] },
            "reason": { "type": "string", "enum": ["unavailable", "disabled"] }
          }
        }
      }
    },
    "x-note-candidates": "TimeToBeatCandidate items always come from HowLongToBeat; IGDB candidates are never listed nor chosen by hand [TTB-035, TTB-040].",
    "x-note": "InvalidParams, GameNotFound and InternalError are the components of v0.15.0. In the full v0.16.0 the existing ProviderUnavailable error gains the provider value hltb and the optional reason field instead of a second -32011 component (only additions)."
  }
}
